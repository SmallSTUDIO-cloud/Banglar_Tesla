{
  "name": "banglar-tesla",
  "private": true,
  "version": "0.1.0",
  "description": "Banglar Tesla \u2014 a 3D Dhaka cycle-rickshaw life simulator (Phase 1 vertical slice).",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "test:ui": "node tests/e2e/ui-flow.mjs",
    "shots": "node tests/e2e/shoot.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/three": "0.186.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}