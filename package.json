{
  "name": "banglar-tesla",
  "private": true,
  "version": "0.6.7",
  "description": "Banglar Tesla \u2014 a 3D Mohammadpur, Dhaka rickshaw driving simulator.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:apk": "npm run build && python3 scripts/build-apk.py",
    "test:android-pipeline": "python3 -m unittest discover -s tests/apk_pipeline -p 'test_*.py'",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "baseline:update": "vite-node scripts/update-gameplay-baseline.ts",
    "baseline:update-world": "vite-node scripts/update-world-baseline.ts",
    "baseline:update-lanes": "vite-node scripts/update-lane-graph-baseline.ts",
    "snapshot:world": "vite-node tools/snapshot-world.ts",
    "snapshot:lanes": "vite-node tools/snapshot-lanegraph.ts",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "test:ui": "node tests/e2e/ui-flow.mjs",
    "test:mobile": "node tests/e2e/mobile-check.mjs",
    "test:street": "node tests/e2e/street-density.mjs",
    "test:spec": "node tests/e2e/verify-spec.mjs",
    "test:upgrade": "node tests/e2e/verify-upgrade-v2.mjs",
    "test:v05": "node tests/e2e/verify-v0.5.0.mjs",
    "test:vnext": "node tests/e2e/verify-vnext.mjs",
    "benchmark": "node tests/e2e/benchmark-suite.mjs",
    "shots": "node tests/e2e/shoot.mjs",
    "perf": "node tests/e2e/perf.mjs",
    "test:vnext-repair": "node tests/e2e/verify-vnext-repair.mjs",
    "test:geography": "node tests/e2e/verify-geography.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/three": "0.186.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
