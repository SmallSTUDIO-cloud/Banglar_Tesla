  "lines": [
    { "id": "intro.league.1", "category": "blacklist", "character": "narrator", "emotion": "dramatic", "delivery": "voiced", "bn": "দশজন ওস্তাদ। একটা মুকুট। মোহাম্মদ্‌পুরের রাস্তা সব দেখে।", "en": "Ten masters. One crown. The streets of Mohammadpur are watching.", "wavBn": "audio/dialogue/intro-league-1-bn.wav", "wavEn": "audio/dialogue/intro-league-1-en.wav", "voice": { "variant": "bn+m4", "pitch": 44, "rate": 150, "range": 66 }, "voiceEn": { "variant": "en-us+m4", "pitch": 44, "rate": 158, "range": 64 } },
    { "id": "intro.league.2", "category": "blacklist", "character": "narrator", "emotion": "dramatic", "delivery": "voiced", "bn": "রাতের অন্ধকারে তিন চাকার যুদ্ধ শুরু হয়!", "en": "Under the night sky, the three-wheel war begins!", "wavBn": "audio/dialogue/intro-league-2-bn.wav", "wavEn": "audio/dialogue/intro-league-2-en.wav", "voice": { "variant": "bn+m4", "pitch": 40, "rate": 146, "range": 72 }, "voiceEn": { "variant": "en-us+m4", "pitch": 40, "rate": 154, "range": 70 } },

    { "id": "rival.bl_10_raju.intro", "category": "blacklist", "character": "bl_10_raju", "emotion": "playful", "delivery": "voiced", "bn": "সরো ভাই, গলি আমার! পার্‌লে পিছে আয়!", "en": "Out of the way — this alley is mine! Try to keep up!", "wavBn": "audio/dialogue/rival-raju-intro-bn.wav", "wavEn": "audio/dialogue/rival-raju-intro-en.wav", "voice": { "variant": "bn+m4", "pitch": 48, "rate": 156, "range": 72 }, "voiceEn": { "variant": "en-us+m4", "pitch": 48, "rate": 162, "range": 70 } },
    { "id": "rival.bl_10_raju.taunt", "category": "blacklist", "character": "bl_10_raju", "emotion": "playful", "delivery": "voiced", "bn": "চিকন গলিতে আমার চাকা বাতাসের আগে ঘোরে! পার্‌লে আমার পিছে আয়!", "en": "My wheels cut narrow lanes faster than the wind! Try keeping up!", "wavBn": "audio/dialogue/rival-raju-taunt-bn.wav", "wavEn": "audio/dialogue/rival-raju-taunt-en.wav", "voice": { "variant": "bn+m4", "pitch": 50, "rate": 158, "range": 74 }, "voiceEn": { "variant": "en-us+m4", "pitch": 50, "rate": 164, "range": 72 } },

    { "id": "rival.bl_09_sumon.intro", "category": "blacklist", "character": "bl_09_sumon", "emotion": "confident", "delivery": "voiced", "bn": "জ্যাম আর গলি, দুটোতেই আমি সেরা!", "en": "Traffic or alleys — I rule both!", "wavBn": "audio/dialogue/rival-sumon-intro-bn.wav", "wavEn": "audio/dialogue/rival-sumon-intro-en.wav", "voice": { "variant": "bn+m2", "pitch": 38, "rate": 150, "range": 62 }, "voiceEn": { "variant": "en-us+m2", "pitch": 38, "rate": 158, "range": 60 } },
    { "id": "rival.bl_09_sumon.taunt", "category": "blacklist", "character": "bl_09_sumon", "emotion": "confident", "delivery": "voiced", "bn": "জ্যামের ভেতর ঘণ্টা বাজিয়েই আমি গায়েব! তোর রিকশা জ্যামেই আটকে থাকবে!", "en": "One ring of my brass bell and I vanish through the jam! Eat my dust!", "wavBn": "audio/dialogue/rival-sumon-taunt-bn.wav", "wavEn": "audio/dialogue/rival-sumon-taunt-en.wav", "voice": { "variant": "bn+m2", "pitch": 36, "rate": 152, "range": 66 }, "voiceEn": { "variant": "en-us+m2", "pitch": 36, "rate": 160, "range": 64 } },

    { "id": "rival.bl_08_tarek.intro", "category": "blacklist", "character": "bl_08_tarek", "emotion": "excited", "delivery": "voiced", "bn": "লাল বত্তি নিভুক আগেই আমি উড়ে যাই!", "en": "I'm gone before the light even turns green!", "wavBn": "audio/dialogue/rival-tarek-intro-bn.wav", "wavEn": "audio/dialogue/rival-tarek-intro-en.wav", "voice": { "variant": "bn+m5", "pitch": 52, "rate": 162, "range": 76 }, "voiceEn": { "variant": "en-us+m5", "pitch": 52, "rate": 168, "range": 74 } },
    { "id": "rival.bl_08_tarek.taunt", "category": "blacklist", "character": "bl_08_tarek", "emotion": "excited", "delivery": "voiced", "bn": "সিগন্‌যাল সবুজ হওয়ার আগেই আমার টান শুরু হয়!", "en": "My launch hits top speed before the signal even turns green!", "wavBn": "audio/dialogue/rival-tarek-taunt-bn.wav", "wavEn": "audio/dialogue/rival-tarek-taunt-en.wav", "voice": { "variant": "bn+m5", "pitch": 54, "rate": 164, "range": 78 }, "voiceEn": { "variant": "en-us+m5", "pitch": 54, "rate": 170, "range": 76 } },

    { "id": "rival.bl_07_nabila.intro", "category": "blacklist", "character": "bl_07_nabila", "emotion": "confident", "delivery": "voiced", "bn": "কারেন্ট চালিত রিকশা — নতুন যুগের ডাক!", "en": "Electric torque — the call of a new era!", "wavBn": "audio/dialogue/rival-nabila-intro-bn.wav", "wavEn": "audio/dialogue/rival-nabila-intro-en.wav", "voice": { "variant": "bn+f2", "pitch": 58, "rate": 152, "range": 64 }, "voiceEn": { "variant": "en-us+f2", "pitch": 58, "rate": 160, "range": 62 } },
    { "id": "rival.bl_07_nabila.taunt", "category": "blacklist", "character": "bl_07_nabila", "emotion": "confident", "delivery": "voiced", "bn": "৪৮ ভোল্‌টের টর্কে তোর প্যাডেল কোনো পাত্তাই পাবে না!", "en": "My 48-volt torque leaves old-school pedals way behind!", "wavBn": "audio/dialogue/rival-nabila-taunt-bn.wav", "wavEn": "audio/dialogue/rival-nabila-taunt-en.wav", "voice": { "variant": "bn+f2", "pitch": 60, "rate": 154, "range": 68 }, "voiceEn": { "variant": "en-us+f2", "pitch": 60, "rate": 162, "range": 66 } },

    { "id": "rival.bl_06_halim.intro", "category": "blacklist", "character": "bl_06_halim", "emotion": "jovial", "delivery": "voiced", "bn": "সময়ের হিসাব রাখো ভাই, পণ্য আর গতি দুটোই আমার!", "en": "Keep your watch, brother — cargo and speed are mine!", "wavBn": "audio/dialogue/rival-halim-intro-bn.wav", "wavEn": "audio/dialogue/rival-halim-intro-en.wav", "voice": { "variant": "bn+m6", "pitch": 34, "rate": 144, "range": 60 }, "voiceEn": { "variant": "en-us+m6", "pitch": 34, "rate": 152, "range": 58 } },
    { "id": "rival.bl_06_halim.taunt", "category": "blacklist", "character": "bl_06_halim", "emotion": "jovial", "delivery": "voiced", "bn": "টাউন হলের ভিড় আমার হাতের তালুর মতো চেনা! সময় শেষ হওয়ার আগে পার্‌বি?", "en": "I know Town Hall Bazar like the back of my hand! Beat my delivery clock!", "wavBn": "audio/dialogue/rival-halim-taunt-bn.wav", "wavEn": "audio/dialogue/rival-halim-taunt-en.wav", "voice": { "variant": "bn+m6", "pitch": 32, "rate": 146, "range": 64 }, "voiceEn": { "variant": "en-us+m6", "pitch": 32, "rate": 154, "range": 62 } },

    { "id": "rival.bl_05_faisal.intro", "category": "blacklist", "character": "bl_05_faisal", "emotion": "cool", "delivery": "voiced", "bn": "সোজা রাস্তা বোরিং, আসো ভেতরের পথে!", "en": "Straight roads are boring — take the inner paths!", "wavBn": "audio/dialogue/rival-faisal-intro-bn.wav", "wavEn": "audio/dialogue/rival-faisal-intro-en.wav", "voice": { "variant": "bn+m1", "pitch": 50, "rate": 156, "range": 58 }, "voiceEn": { "variant": "en-us+m1", "pitch": 50, "rate": 164, "range": 56 } },
    { "id": "rival.bl_05_faisal.taunt", "category": "blacklist", "character": "bl_05_faisal", "emotion": "cool", "delivery": "voiced", "bn": "সোজা রাস্তায় সবাই চালায়, আসল খেলা তো চোরাবালি শর্টকাটে!", "en": "Anyone can ride main avenues — real legends own the hidden shortcuts!", "wavBn": "audio/dialogue/rival-faisal-taunt-bn.wav", "wavEn": "audio/dialogue/rival-faisal-taunt-en.wav", "voice": { "variant": "bn+m1", "pitch": 48, "rate": 158, "range": 62 }, "voiceEn": { "variant": "en-us+m1", "pitch": 48, "rate": 166, "range": 60 } },

    { "id": "rival.bl_04_badol.intro", "category": "blacklist", "character": "bl_04_badol", "emotion": "calm", "delivery": "voiced", "bn": "মেঘ দেখে ভয় পাও? আমার কাছে এটাই সেরা আবহাওয়া!", "en": "Afraid of clouds? This is my perfect weather!", "wavBn": "audio/dialogue/rival-badol-intro-bn.wav", "wavEn": "audio/dialogue/rival-badol-intro-en.wav", "voice": { "variant": "bn+m7", "pitch": 40, "rate": 148, "range": 56 }, "voiceEn": { "variant": "en-us+m7", "pitch": 40, "rate": 156, "range": 54 } },
    { "id": "rival.bl_04_badol.taunt", "category": "blacklist", "character": "bl_04_badol", "emotion": "calm", "delivery": "voiced", "bn": "ঝুম বৃষ্টিতে যখন সবার ব্রেক পিছলায়, তখন বাদল মিয়ার রিকশা ওড়ে!", "en": "When monsoon rain makes everyone slip, Badol Mia flies through corners!", "wavBn": "audio/dialogue/rival-badol-taunt-bn.wav", "wavEn": "audio/dialogue/rival-badol-taunt-en.wav", "voice": { "variant": "bn+m7", "pitch": 38, "rate": 150, "range": 60 }, "voiceEn": { "variant": "en-us+m7", "pitch": 38, "rate": 158, "range": 58 } },

    { "id": "rival.bl_03_sakib.intro", "category": "blacklist", "character": "bl_03_sakib", "emotion": "intense", "delivery": "voiced", "bn": "সাইরেন শোনো — এই শহরে আমিই আইন!", "en": "Hear that siren? In this city, I am the law!", "wavBn": "audio/dialogue/rival-sakib-intro-bn.wav", "wavEn": "audio/dialogue/rival-sakib-intro-en.wav", "voice": { "variant": "bn+m3", "pitch": 42, "rate": 152, "range": 70 }, "voiceEn": { "variant": "en-us+m3", "pitch": 42, "rate": 160, "range": 68 } },
    { "id": "rival.bl_03_sakib.taunt", "category": "blacklist", "character": "bl_03_sakib", "emotion": "intense", "delivery": "voiced", "bn": "পুলিশের সাইরেন শুনলেই তোর হাত কাঁপে, আর আমার টার্বো জ্বলে ওঠে!", "en": "Police sirens make your hands shake — they just wake my Turbo up!", "wavBn": "audio/dialogue/rival-sakib-taunt-bn.wav", "wavEn": "audio/dialogue/rival-sakib-taunt-en.wav", "voice": { "variant": "bn+m3", "pitch": 40, "rate": 154, "range": 72 }, "voiceEn": { "variant": "en-us+m3", "pitch": 40, "rate": 162, "range": 70 } },

    { "id": "rival.bl_02_ranga.intro", "category": "blacklist", "character": "bl_02_ranga", "emotion": "fierce", "delivery": "voiced", "bn": "আমার সামনে টিকলে তবেই তুমি রেসার!", "en": "Survive in front of me — then call yourself a racer!", "wavBn": "audio/dialogue/rival-ranga-intro-bn.wav", "wavEn": "audio/dialogue/rival-ranga-intro-en.wav", "voice": { "variant": "bn+m2", "pitch": 32, "rate": 146, "range": 74 }, "voiceEn": { "variant": "en-us+m2", "pitch": 32, "rate": 154, "range": 72 } },
    { "id": "rival.bl_02_ranga.taunt", "category": "blacklist", "character": "bl_02_ranga", "emotion": "fierce", "delivery": "voiced", "bn": "রিং রোডে আমার টার্বোর আগুনের সামনে কেউ টিকে থাকতে পারেনি!", "en": "Nobody has ever survived my Turbo flames down the Ring Road straight!", "wavBn": "audio/dialogue/rival-ranga-taunt-bn.wav", "wavEn": "audio/dialogue/rival-ranga-taunt-en.wav", "voice": { "variant": "bn+m2", "pitch": 30, "rate": 148, "range": 78 }, "voiceEn": { "variant": "en-us+m2", "pitch": 30, "rate": 156, "range": 76 } },

    { "id": "rival.bl_01_samrat.intro", "category": "blacklist", "character": "bl_01_samrat", "emotion": "triumphant", "delivery": "voiced", "bn": "মোহাম্মদ্‌পুরের রাজা দাঁড়ালে রাস্তা নিভে যায়!", "en": "When the king of Mohammadpur stands, the streets fall silent!", "wavBn": "audio/dialogue/rival-samrat-intro-bn.wav", "wavEn": "audio/dialogue/rival-samrat-intro-en.wav", "voice": { "variant": "bn+m6", "pitch": 28, "rate": 142, "range": 62 }, "voiceEn": { "variant": "en-us+m6", "pitch": 28, "rate": 150, "range": 60 } },
    { "id": "rival.bl_01_samrat.taunt", "category": "blacklist", "character": "bl_01_samrat", "emotion": "triumphant", "delivery": "voiced", "bn": "মোহাম্মদ্‌পুরের রাস্তা আজ আমার দখলে! পার্‌লে ধরে দেখা, নতুন ওস্তাদ!", "en": "Mohammadpur's streets belong to me tonight! Catch me if you can, challenger!", "wavBn": "audio/dialogue/rival-samrat-taunt-bn.wav", "wavEn": "audio/dialogue/rival-samrat-taunt-en.wav", "voice": { "variant": "bn+m6", "pitch": 26, "rate": 144, "range": 66 }, "voiceEn": { "variant": "en-us+m6", "pitch": 26, "rate": 152, "range": 64 } },

    { "id": "police.escalate.1", "category": "police", "character": "police", "emotion": "command", "delivery": "voiced", "bn": "সব পুলিশ ইউনিট শোনো, আসাদ গেটে ব্যারিকেড বসাও!", "en": "All units, set up barricades at Asad Gate!", "wavBn": "audio/dialogue/police-escalate-bn.wav", "wavEn": "audio/dialogue/police-escalate-en.wav", "radio": true, "voice": { "variant": "bn+m2", "pitch": 42, "rate": 158, "range": 58 }, "voiceEn": { "variant": "en-us+m2", "pitch": 42, "rate": 166, "range": 56 } },

    { "id": "roadrage.driver.line2", "category": "road_rage", "character": "sedan_driver", "emotion": "angry", "delivery": "voiced", "bn": "রিকশা রাস্তায় নামালে এমনই হয়!", "en": "This is what happens when you put a rickshaw on MY road!", "wavBn": "audio/dialogue/roadrage-driver-2-bn.wav", "wavEn": "audio/dialogue/roadrage-driver-2-en.wav", "voice": { "variant": "bn+m3", "pitch": 36, "rate": 152, "range": 72 }, "voiceEn": { "variant": "en-us+m3", "pitch": 36, "rate": 160, "range": 70 } },
    { "id": "roadrage.settle.1", "category": "road_rage", "character": "player", "emotion": "apologetic", "delivery": "voiced", "bn": "ঠিক আছে ভাই, মিটিয়ে নাও।", "en": "Alright brother, let's settle this.", "wavBn": "audio/dialogue/roadrage-settle-bn.wav", "wavEn": "audio/dialogue/roadrage-settle-en.wav", "voice": { "variant": "bn+m7", "pitch": 54, "rate": 156, "range": 60 }, "voiceEn": { "variant": "en-us+m7", "pitch": 54, "rate": 164, "range": 58 } },

    { "id": "race.start.1", "category": "race", "character": "announcer", "emotion": "excited", "delivery": "voiced", "bn": "প্রস্তুত? তিন, দুই, এক — শুরু!", "en": "Ready? Three, two, one — go!", "wavBn": "audio/dialogue/race-start-bn.wav", "wavEn": "audio/dialogue/race-start-en.wav", "voice": { "variant": "bn+m4", "pitch": 52, "rate": 154, "range": 76 }, "voiceEn": { "variant": "en-us+m4", "pitch": 52, "rate": 162, "range": 74 } },
    { "id": "race.win.1", "category": "race", "character": "announcer", "emotion": "triumphant", "delivery": "voiced", "bn": "দারুণ চালানো! এই জয় তোমার!", "en": "Brilliant driving — this win is yours!", "wavBn": "audio/dialogue/race-win-bn.wav", "wavEn": "audio/dialogue/race-win-en.wav", "voice": { "variant": "bn+m4", "pitch": 54, "rate": 152, "range": 78 }, "voiceEn": { "variant": "en-us+m4", "pitch": 54, "rate": 160, "range": 76 } },
    { "id": "race.lose.1", "category": "race", "character": "announcer", "emotion": "supportive", "delivery": "voiced", "bn": "এইবার হারলে, পরেরবার জিতবে! আবার এসো।", "en": "Not this time. Come back and win the next one!", "wavBn": "audio/dialogue/race-lose-bn.wav", "wavEn": "audio/dialogue/race-lose-en.wav", "voice": { "variant": "bn+m4", "pitch": 46, "rate": 150, "range": 62 }, "voiceEn": { "variant": "en-us+m4", "pitch": 46, "rate": 158, "range": 60 } },

    { "id": "mission.roadside.call", "category": "mission", "character": "roadside.speaker", "emotion": "calling", "delivery": "voiced", "bn": "মামা যাবেন?", "en": "Uncle, can you take me?", "wavBn": "audio/dialogue/roadside-call-bn.wav", "wavEn": "audio/dialogue/roadside-call-en.wav", "voice": { "variant": "bn+f3", "pitch": 58, "rate": 150, "range": 62 }, "voiceEn": { "variant": "en-us+f3", "pitch": 58, "rate": 158, "range": 60 }, "qa": "synthetic; listening review pending" },
    { "id": "mission.roadside.accept", "category": "mission", "character": "roadside.speaker", "emotion": "agreeing", "delivery": "voiced", "bn": "ঠিক আছে, চলেন।", "en": "All right, let's go.", "wavBn": "audio/dialogue/roadside-accept-bn.wav", "wavEn": "audio/dialogue/roadside-accept-en.wav", "voice": { "variant": "bn+f3", "pitch": 58, "rate": 150, "range": 62 }, "voiceEn": { "variant": "en-us+f3", "pitch": 58, "rate": 158, "range": 60 }, "qa": "synthetic; listening review pending" },
    { "id": "mission.roadside.reject", "category": "mission", "character": "roadside.speaker", "emotion": "declining", "delivery": "voiced", "bn": "না, এত ভাড়া দেব না।", "en": "No, I can't pay that much.", "wavBn": "audio/dialogue/roadside-reject-bn.wav", "wavEn": "audio/dialogue/roadside-reject-en.wav", "voice": { "variant": "bn+f3", "pitch": 58, "rate": 150, "range": 62 }, "voiceEn": { "variant": "en-us+f3", "pitch": 58, "rate": 158, "range": 60 }, "qa": "synthetic; listening review pending" },
    { "id": "mission.roadside.cancel", "category": "mission", "character": "roadside.speaker", "emotion": "neutral", "delivery": "voiced", "bn": "আচ্ছা, থাক।", "en": "All right, never mind.", "wavBn": "audio/dialogue/roadside-cancel-bn.wav", "wavEn": "audio/dialogue/roadside-cancel-en.wav", "voice": { "variant": "bn+f3", "pitch": 58, "rate": 150, "range": 62 }, "voiceEn": { "variant": "en-us+f3", "pitch": 58, "rate": 158, "range": 60 }, "qa": "synthetic; listening review pending" },
