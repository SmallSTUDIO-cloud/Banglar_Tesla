.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(238, 242, 224);
    -unity-text-generator: advanced;
}

.hud-safe {
    position: absolute;
    overflow: visible;
}

.hud-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-top-strip {
    position: absolute;
    left: 236px;
    right: 244px;
    top: 12px;
    min-height: 48px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(225, 185, 100, 0.28);
    background-color: rgba(7, 28, 24, 0.88);
}

.hud-stat {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(237, 231, 199);
}

.hud-stat-accent {
    color: rgb(246, 193, 91);
}

.hud-mission {
    position: absolute;
    left: 14px;
    top: 12px;
    width: 214px;
    min-height: 88px;
    padding: 12px;
    border-radius: 18px;
    border-left-width: 2px;
    border-color: rgb(222, 169, 74);
    background-color: rgba(8, 38, 30, 0.90);
}

.hud-mission-kicker {
    font-size: 11px;
    color: rgb(110, 213, 177);
    -unity-font-style: bold;
}

.hud-mission-title {
    margin-top: 4px;
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
}

.hud-mission-subtitle {
    margin-top: 3px;
    font-size: 12px;
    color: rgb(190, 205, 188);
    white-space: normal;
}

.hud-control {
    position: absolute;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 22px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(202, 224, 197, 0.34);
    background-color: rgba(10, 42, 34, 0.90);
}

.hud-control.round {
    border-radius: 80px;
}

.hud-control.pedal {
    border-width: 4px;
    border-color: rgb(232, 178, 83);
    background-color: rgba(15, 70, 50, 0.94);
}

.hud-control.brake {
    border-color: rgb(215, 83, 68);
    background-color: rgba(77, 28, 25, 0.93);
}

.hud-control.turbo {
    border-color: rgb(65, 197, 194);
    background-color: rgba(8, 50, 52, 0.93);
}

.hud-control.steering {
    border-radius: 28px;
    border-color: rgba(235, 194, 109, 0.66);
    background-color: rgba(14, 52, 40, 0.92);
}

.hud-control.utility {
    border-radius: 18px;
    border-width: 1px;
    background-color: rgba(8, 30, 26, 0.86);
}

.hud-control.minimap {
    border-radius: 26px;
    border-color: rgba(223, 178, 88, 0.72);
    background-color: rgba(5, 24, 21, 0.91);
}

.hud-control.context {
    border-radius: 28px;
    border-color: rgb(78, 194, 152);
    background-color: rgba(10, 59, 42, 0.94);
}

.hud-control.pressed,
.hud-control.selected {
    border-color: rgb(255, 221, 137);
    background-color: rgba(32, 92, 62, 0.96);
}

.hud-control.edit-mode {
    border-color: rgb(111, 227, 209);
}

.control-icon {
    width: 58%;
    height: 58%;
    flex-shrink: 0;
}

.control-label {
    margin-top: -8px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(239, 238, 215);
}

.utility .control-icon {
    width: 52%;
    height: 52%;
}

.utility .control-label {
    display: none;
}

.minimap .control-icon {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    width: auto;
    height: auto;
}

.minimap .control-label {
    position: absolute;
    right: 8px;
    bottom: 3px;
    font-size: 9px;
    color: rgba(223, 231, 211, 0.76);
}

.map-marker {
    position: absolute;
    left: 48%;
    top: 46%;
    width: 14px;
    height: 14px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(255, 241, 183);
    background-color: rgb(222, 91, 64);
}

.charge-track {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 7px;
    height: 5px;
    border-radius: 3px;
    background-color: rgba(2, 21, 22, 0.85);
    overflow: hidden;
}

.charge-fill {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    border-radius: 3px;
    background-color: rgb(76, 220, 211);
}

.hud-customize {
    position: absolute;
    left: 22px;
    top: 112px;
    width: 348px;
    padding: 18px;
    border-radius: 22px;
    border-width: 2px;
    border-color: rgb(220, 175, 89);
    background-color: rgba(5, 27, 24, 0.98);
}

.hud-customize-title {
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(246, 205, 119);
}

.hud-customize-help {
    margin-top: 4px;
    margin-bottom: 12px;
    font-size: 12px;
    color: rgb(179, 204, 187);
    white-space: normal;
}

.hud-customize-row {
    margin-top: 9px;
    min-height: 32px;
}

.hud-customize-actions {
    margin-top: 16px;
    flex-direction: row;
    justify-content: space-between;
}

.hud-customize-actions Button {
    min-width: 126px;
    min-height: 42px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(211, 172, 94);
    background-color: rgb(20, 77, 53);
    color: rgb(245, 238, 208);
    -unity-font-style: bold;
}

.hud-toast {
    position: absolute;
    left: 38%;
    right: 38%;
    bottom: 18px;
    padding: 10px;
    border-radius: 15px;
    background-color: rgba(7, 32, 26, 0.90);
    -unity-text-align: middle-center;
    font-size: 13px;
}

.hud-customize {
    width: 34px;
    height: 34px;
    margin-left: 6px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    background-color: rgba(14, 31, 34, 0.88);
    color: rgb(242, 212, 139);
    font-size: 19px;
    -unity-text-align: middle-center;
}
